// Prisma Schema: PasarKu Multi-Vendor Marketplace
// 32 Relational Tables with full indexation, foreign keys & zero-trust constraints

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. USERS & AUTHENTICATION
// -------------------------------------------------------------
model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  passwordHash    String
  role            String         @default("BUYER") // BUYER, SELLER, ADMIN
  phone           String?
  avatarUrl       String?
  status          String         @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions        Session[]
  addresses       Address[]
  store           Store?
  carts           Cart[]
  orders          Order[]
  wishlists       Wishlist[]
  reviews         Review[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  voucherRedemptions VoucherRedemption[]
  refunds         Refund[]
  sentMessages    Message[]      @relation("SentMessages")
  conversationsAsBuyer Conversation[] @relation("BuyerConversations")
  reviewedVerifications StoreVerification[] @relation("AdminVerifier")
  approvedPayouts PayoutRequest[] @relation("AdminPayoutApprover")
  reviewedRefunds Refund[]       @relation("AdminRefundReviewer")

  @@map("users")
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  recipientName  String
  phoneNumber    String
  addressLine    String
  cityId         String
  cityName       String
  postalCode     String
  isDefault      Boolean  @default(false)
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// -------------------------------------------------------------
// 2. STORES & SELLER ENTITIES
// -------------------------------------------------------------
model Store {
  id           String             @id @default(uuid())
  userId       String             @unique
  storeName    String
  slug         String             @unique
  description  String?
  logoUrl      String?
  bannerUrl    String?
  isVerified   Boolean            @default(false)
  status       String             @default("ACTIVE") // ACTIVE, VACATION, BANNED
  ratingAvg    Float              @default(5.0)
  ratingCount  Int                @default(0)
  cityId       String             @default("JKT")
  cityName     String             @default("Jakarta")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification StoreVerification?
  products     Product[]
  vouchers     Voucher[]
  wallet       Wallet?
  subOrders    SubOrder[]
  payouts      PayoutRequest[]
  conversations Conversation[]
  commissions  Commission[]

  @@map("stores")
}

model StoreVerification {
  id             String    @id @default(uuid())
  storeId        String    @unique
  ktpNumber      String
  npwpNumber     String?
  ktpImage       String?
  selfieImage    String?
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewerId     String?
  notes          String?
  submittedAt    DateTime  @default(now())
  reviewedAt     DateTime?

  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reviewer       User?     @relation("AdminVerifier", fields: [reviewerId], references: [id])

  @@map("store_verifications")
}

// -------------------------------------------------------------
// 3. CATALOG & INVENTORY
// -------------------------------------------------------------
model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  parentId    String?
  icon        String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid())
  storeId     String
  categoryId  String
  name        String
  slug        String
  description String
  priceMin    Float
  priceMax    Float
  condition   String           @default("NEW") // NEW, USED
  weightGram  Int              @default(500)
  isPublished Boolean          @default(true)
  status      String           @default("ACTIVE") // ACTIVE, INACTIVE, MODERATED
  soldCount   Int              @default(0)
  ratingAvg   Float            @default(5.0)
  viewCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  wishlists   Wishlist[]

  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  imageUrl  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id         String     @id @default(uuid())
  productId  String
  sku        String     @unique
  title      String
  price      Float
  weightGram Int        @default(500)
  isActive   Boolean    @default(true)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id               String         @id @default(uuid())
  productVariantId String         @unique
  stockQty         Int            @default(0)
  reservedQty      Int            @default(0)
  minStockAlert    Int            @default(5)
  updatedAt        DateTime       @updatedAt

  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

// -------------------------------------------------------------
// 4. SHOPPING CART
// -------------------------------------------------------------
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id               String          @id @default(uuid())
  cartId           String
  productId        String
  productVariantId String
  storeId          String
  quantity         Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

// -------------------------------------------------------------
// 5. ORDERS & MULTI-VENDOR SUB-ORDERS
// -------------------------------------------------------------
model Order {
  id                  String              @id @default(uuid())
  orderNumber         String              @unique
  buyerId             String
  totalGoodsAmount    Float
  totalShippingAmount Float
  totalDiscountAmount Float               @default(0)
  platformFee         Float               @default(1000)
  grandTotal          Float
  paymentStatus       String              @default("UNPAID") // UNPAID, PAID, EXPIRED, CANCELLED
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  buyer               User                @relation(fields: [buyerId], references: [id])
  subOrders           SubOrder[]
  payment             Payment?
  voucherRedemptions  VoucherRedemption[]

  @@index([buyerId])
  @@map("orders")
}

model SubOrder {
  id                String       @id @default(uuid())
  subOrderNumber    String       @unique
  parentOrderId     String
  storeId           String
  goodsAmount       Float
  shippingAmount    Float
  discountAmount    Float        @default(0)
  subTotal          Float
  status            String       @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, PROCESSING, SHIPPED, DELIVERED, COMPLETED, CANCELLED, REFUNDED
  cancellationReason String?
  autoCancelAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parentOrder       Order        @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  store             Store        @relation(fields: [storeId], references: [id])
  items             OrderItem[]
  shipment          Shipment?
  commission        Commission?
  refunds           Refund[]

  @@index([parentOrderId])
  @@index([storeId])
  @@map("sub_orders")
}

model OrderItem {
  id                   String         @id @default(uuid())
  subOrderId           String
  productId            String
  productVariantId     String
  productNameSnapshot  String
  variantTitleSnapshot String
  priceSnapshot        Float
  weightSnapshot       Int
  quantity             Int
  subtotal             Float

  subOrder             SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  product              Product        @relation(fields: [productId], references: [id])
  variant              ProductVariant @relation(fields: [productVariantId], references: [id])
  review               Review?

  @@index([subOrderId])
  @@map("order_items")
}

// -------------------------------------------------------------
// 6. PAYMENTS & GATEWAY EVENTS
// -------------------------------------------------------------
model Payment {
  id                String         @id @default(uuid())
  parentOrderId     String         @unique
  transactionNumber String         @unique
  paymentMethod     String         // BCA_VA, MANDIRI_VA, QRIS, GOPAY, COD, etc.
  paymentChannel    String?
  paymentCode       String?
  qrString          String?
  grossAmount       Float
  status            String         @default("PENDING") // PENDING, SETTLED, EXPIRED, FAILED
  gatewayResponse   String?
  expiredAt         DateTime
  settledAt         DateTime?
  createdAt         DateTime       @default(now())

  parentOrder       Order          @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]

  @@map("payments")
}

model PaymentEvent {
  id                String   @id @default(uuid())
  paymentId         String
  eventType         String
  idempotencyKey    String   @unique
  rawPayload        String
  signatureVerified Boolean  @default(false)
  processedAt       DateTime @default(now())

  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

// -------------------------------------------------------------
// 7. SHIPMENTS & LOGISTICS
// -------------------------------------------------------------
model Shipment {
  id                       String          @id @default(uuid())
  subOrderId               String          @unique
  courierCode              String          // JNE, SICEPAT, GOSEND
  courierService           String
  trackingNumber           String?
  shippingCost             Float
  originCity               String
  destinationCity          String
  recipientAddressSnapshot String
  shippedAt                DateTime?
  deliveredAt              DateTime?

  subOrder                 SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  events                   ShipmentEvent[]

  @@map("shipments")
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  statusCode  String   // MANIFESTED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED
  description String
  location    String
  timestamp   DateTime @default(now())

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
}

// -------------------------------------------------------------
// 8. COMMISSIONS, WALLETS & LEDGER
// -------------------------------------------------------------
model Commission {
  id               String   @id @default(uuid())
  subOrderId       String   @unique
  storeId          String
  ratePercent      Float    @default(2.5)
  commissionAmount Float
  netSellerAmount  Float
  status           String   @default("PENDING") // PENDING, COLLECTED, REFUNDED
  createdAt        DateTime @default(now())

  subOrder         SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  store            Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("commissions")
}

model Wallet {
  id               String              @id @default(uuid())
  storeId          String              @unique
  holdingBalance   Float               @default(0.0) // Escrow
  availableBalance Float               @default(0.0) // Siap cair
  totalWithdrawn   Float               @default(0.0)
  updatedAt        DateTime            @updatedAt

  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]
  payouts          PayoutRequest[]

  @@map("wallets")
}

model WalletTransaction {
  id            String   @id @default(uuid())
  walletId      String
  referenceType String   // SUB_ORDER_SETTLEMENT, PAYOUT_WITHDRAWAL, REFUND_REVERSAL, MANUAL_ADJUSTMENT
  referenceId   String
  type          String   // CREDIT, DEBIT
  balanceType   String   // HOLDING, AVAILABLE
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  description   String
  createdAt     DateTime @default(now())

  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_transactions")
}

model PayoutRequest {
  id            String    @id @default(uuid())
  walletId      String
  storeId       String
  amount        Float
  bankName      String
  accountNumber String
  accountHolder String
  status        String    @default("REQUESTED") // REQUESTED, APPROVED, PROCESSING, COMPLETED, REJECTED
  adminNotes    String?
  approvedById  String?
  transferredAt DateTime?
  createdAt     DateTime  @default(now())

  wallet        Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  store         Store     @relation(fields: [storeId], references: [id])
  approvedBy    User?     @relation("AdminPayoutApprover", fields: [approvedById], references: [id])

  @@index([storeId])
  @@map("payout_requests")
}

// -------------------------------------------------------------
// 9. REFUNDS, REVIEWS & WISHLISTS
// -------------------------------------------------------------
model Refund {
  id             String    @id @default(uuid())
  subOrderId     String
  buyerId        String
  amount         Float
  reason         String
  proofImages    String?   // JSON Array of URLs
  status         String    @default("REQUESTED") // REQUESTED, ACCEPTED, REJECTED, DISPUTED, COMPLETED
  resolutionType String?   // FULL_REFUND, PARTIAL_REFUND, REJECTED
  reviewedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  subOrder       SubOrder  @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  buyer          User      @relation(fields: [buyerId], references: [id])
  reviewedBy     User?     @relation("AdminRefundReviewer", fields: [reviewedById], references: [id])

  @@index([subOrderId])
  @@map("refunds")
}

model Review {
  id           String    @id @default(uuid())
  orderItemId  String    @unique
  productId    String
  userId       String
  rating       Int       // 1 - 5
  comment      String
  replyComment String?
  replyAt      DateTime?
  createdAt    DateTime  @default(now())

  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

// -------------------------------------------------------------
// 10. VOUCHERS & PROMOTIONS
// -------------------------------------------------------------
model Voucher {
  id               String              @id @default(uuid())
  storeId          String?             // Null jika voucher platform global
  code             String              @unique
  title            String
  discountType     String              // PERCENTAGE, FIXED
  discountValue    Float
  maxDiscountAmount Float?
  minOrderAmount   Float               @default(0)
  quotaTotal       Int                 @default(100)
  quotaUsed        Int                 @default(0)
  startDate        DateTime            @default(now())
  endDate          DateTime
  isActive         Boolean             @default(true)

  store            Store?              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  redemptions      VoucherRedemption[]

  @@map("vouchers")
}

model VoucherRedemption {
  id             String   @id @default(uuid())
  voucherId      String
  orderId        String
  userId         String
  discountAmount Float
  redeemedAt     DateTime @default(now())

  voucher        Voucher  @relation(fields: [voucherId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])

  @@index([voucherId])
  @@index([orderId])
  @@map("voucher_redemptions")
}

// -------------------------------------------------------------
// 11. IN-APP MESSAGING & NOTIFICATIONS
// -------------------------------------------------------------
model Conversation {
  id            String    @id @default(uuid())
  buyerId       String
  storeId       String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  buyer         User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([buyerId, storeId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  messageText    String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  actionUrl String?
  type      String   // TRANSACTION, SHIPPING, PROMO, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// -------------------------------------------------------------
// 12. AUDIT LOGS & SETTINGS
// -------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g., ORDER_CREATED, PAYMENT_VERIFIED, PAYOUT_APPROVED
  resource   String
  resourceId String
  ipAddress  String?
  userAgent  String?
  payload    String?  // JSON string
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
